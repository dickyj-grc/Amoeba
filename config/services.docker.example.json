{
  "version": 1,
  "machines": {
    "local": {
      "type": "vm",
      "drivers": ["docker"],
      "resources": {}
    }
  },
  "services": {
    "gemma4": {
      "placement": { "type": "vm", "ip": "amoeba-gemma4-worker", "port": 11434, "cooldown_seconds": 180 },
      "container": { "image": "ollama/ollama:latest" },
      "permissions": {
        "read": ["admin", "analyst"],
        "add": ["admin", "analyst"]
      },
      "upstream_auth": null
    },
    "docling": {
      "placement": { "type": "vm", "ip": "amoeba-docling-worker", "port": 5000, "cooldown_seconds": 120 },
      "container": { "image": "ds4sd/docling-serve:latest" },
      "permissions": {
        "read": ["admin", "analyst"],
        "add": ["admin", "analyst"]
      },
      "upstream_auth": null
    }
  }
}
