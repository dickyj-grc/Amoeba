{
  "services": {
    "gemma4": {
      "image": "ollama/ollama:latest",
      "ip": "192.168.100.20",
      "port": 11434,
      "memory": "16g",
      "cooldown_seconds": 60,
      "operation_rules": [
        { "operation": "read", "match_type": "http_method", "values": ["GET", "HEAD"] },
        { "operation": "execute", "match_type": "http_method", "values": ["POST"] }
      ],
      "permissions": {
        "read": ["admin", "analyst", "viewer"],
        "execute": ["admin", "analyst"]
      },
      "upstream_auth": null
    }
  }
}
